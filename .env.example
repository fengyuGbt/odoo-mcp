# Odoo connection settings (copy to .env and fill in real values)
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_DB=your-db-name
ODOO_USER=your-login@example.com
ODOO_API_KEY=your-api-key

# Optional: restrict which models the server can query (comma-separated)
# ODOO_ALLOWED_MODELS=sale.order,res.partner,product.product,stock.quant,ir.model
